{
  "name": "@bugu/desktop",
  "version": "0.4.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Electron desktop app for Buguniao",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@bugu/core": "workspace:*",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "docx": "^9.7.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "undici": "^8.10.0",
    "vite": "^8.2.2",
    "vitest": "^3.0.5",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "main": "out/main/index.cjs",
  "build": {
    "appId": "com.buguniao.app",
    "productName": "不咕鸟",
    "copyright": "不咕鸟",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!out/smoke-*",
      "!out/**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Buguniao-${version}-${arch}-${ext}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "不咕鸟",
      "artifactName": "buguniao-setup-${version}.exe"
    },
    "portable": {
      "artifactName": "buguniao-${version}-win-x64.exe"
    }
  }
}
